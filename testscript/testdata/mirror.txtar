# vi: set ft=conf

# convert crlf to lf on windows
[windows] dos2unix info1.txt info2.txt tree.txt

# start sundae serve
exec sundae serve &
# wait for SSH server to start
ensureserverrunning SSH_PORT

# import a repo
sundae repo import --mirror charmbracelet/wizard-tutorial https://github.com/charmbracelet/wizard-tutorial.git

# check empty description file
readfile $DATA_PATH/repos/charmbracelet/wizard-tutorial.git/description ''

# check repo info
sundae repo info charmbracelet/wizard-tutorial
cmp stdout info1.txt

# check repo list
sundae repo list
stdout charmbracelet/wizard-tutorial

# create a non-mirror repo
sundae repo create test-normal
sundae repo mirror test-normal
stdout false
# try to enable mirror on repo without remote - should fail
! sundae repo mirror test-normal true

# disable mirror
sundae repo mirror charmbracelet/wizard-tutorial false
sundae repo mirror charmbracelet/wizard-tutorial
stdout false
# verify git config no longer has mirror
readfile $DATA_PATH/repos/charmbracelet/wizard-tutorial.git/config
! stdout 'mirror = true'

# re-enable mirror
sundae repo mirror charmbracelet/wizard-tutorial true
sundae repo mirror charmbracelet/wizard-tutorial
stdout true
# verify git config has mirror again
readfile $DATA_PATH/repos/charmbracelet/wizard-tutorial.git/config
stdout 'mirror = true'

# set project name
sundae repo project-name charmbracelet/wizard-tutorial wizard-tutorial
sundae repo list
stdout wizard-tutorial


# check description
sundae repo description charmbracelet/wizard-tutorial
! stdout .

# set description
sundae repo description charmbracelet/wizard-tutorial "testing repo"
sundae repo description charmbracelet/wizard-tutorial
stdout 'testing repo'
readfile $DATA_PATH/repos/charmbracelet/wizard-tutorial.git/description 'testing repo'

# rename
sundae repo rename charmbracelet/wizard-tutorial charmbracelet/test
sundae repo list
stdout charmbracelet/test # TODO: shouldn't this still show the project-name?

# check its not private
sundae repo private charmbracelet/test
stdout false
exists $DATA_PATH/repos/charmbracelet/test.git/git-daemon-export-ok

# make it private
sundae repo private charmbracelet/test  true
sundae repo private charmbracelet/test
stdout true
! exists $DATA_PATH/repos/charmbracelet/test.git/git-daemon-export-ok

# check its not hidden
sundae repo hidden charmbracelet/test
stdout false

# make it hidden
sundae repo hidden charmbracelet/test  true
sundae repo hidden charmbracelet/test
stdout true

# print tree
sundae repo tree charmbracelet/test
cmp stdout tree.txt

# check repo info again
sundae repo info charmbracelet/test
cmp stdout info2.txt

# get a file
sundae repo blob charmbracelet/test README.md
stdout '.*Wizard.*'

# stop the server
[windows] stopserver
[windows] ! stderr .


-- info1.txt --
Project Name:
Repository: charmbracelet/wizard-tutorial
Description:
VCS: jj
Private: false
Hidden: false
Mirror: true
Owner: admin
Default Bookmark: main
Bookmarks:
  - main
-- info2.txt --
Project Name: wizard-tutorial
Repository: charmbracelet/test
Description: testing repo
VCS: jj
Private: true
Hidden: true
Mirror: true
Owner: admin
Default Bookmark: main
Bookmarks:
  - main
-- tree.txt --
-rw-r--r--	10 B	 .gitignore
-rw-r--r--	1.3 kB	 README.md
-rw-r--r--	970 B	 go.mod
-rw-r--r--	5.3 kB	 go.sum
-rw-r--r--	2.2 kB	 input.go
-rw-r--r--	2.9 kB	 main.go
