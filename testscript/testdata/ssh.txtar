# vi: set ft=conf

[windows] dos2unix argserr1.txt argserr2.txt argserr3.txt invalidrepoerr.txt notauthorizederr.txt

# start sundae serve
exec sundae serve &
# wait for SSH server to start
ensureserverrunning SSH_PORT

# create a user
sundae user create foo --key "$USER1_AUTHORIZED_KEY"

# create a repo
sundae repo create repo1
sundae repo create repo1p -p
usundae repo create repo2
usundae repo create repo2p -p

# SSH Git commands as admin
! sundae git-upload-pack
cmp stderr argserr1.txt
! sundae git-upload-pack foobar
cmp stderr invalidrepoerr.txt
! sundae git-upload-archive
cmp stderr argserr1.txt
! sundae git-upload-archive foobar
cmp stderr invalidrepoerr.txt
! sundae git-receive-pack
cmp stderr argserr1.txt
! sundae git-receive-pack foobar
stdout '.*0000 capabilities.*git.*' # git pack response
stderr '.*something went wrong.*'
! sundae git-lfs-authenticate
cmp stderr argserr2.txt
! sundae git-lfs-authenticate foobar
cmp stderr argserr3.txt
! sundae git-lfs-authenticate foobar download
cmp stderr invalidrepoerr.txt
! sundae git-lfs-authenticate foobar upload
cmp stderr invalidrepoerr.txt
sundae git-lfs-authenticate repo1 download
stdout '.*header.*Bearer.*href.*expires_in.*expires_at.*'
sundae git-lfs-authenticate repo1 upload
stdout '.*header.*Bearer.*href.*expires_in.*expires_at.*'
sundae git-lfs-authenticate repo1p download
stdout '.*header.*Bearer.*href.*expires_in.*expires_at.*'
sundae git-lfs-authenticate repo1p upload
stdout '.*header.*Bearer.*href.*expires_in.*expires_at.*'
sundae git-lfs-authenticate repo2 download
stdout '.*header.*Bearer.*href.*expires_in.*expires_at.*'
sundae git-lfs-authenticate repo2 upload
stdout '.*header.*Bearer.*href.*expires_in.*expires_at.*'
sundae git-lfs-authenticate repo2p download
stdout '.*header.*Bearer.*href.*expires_in.*expires_at.*'
sundae git-lfs-authenticate repo2p upload
stdout '.*header.*Bearer.*href.*expires_in.*expires_at.*'

# SSH Git commands as user
! usundae git-upload-pack
cmp stderr argserr1.txt
! usundae git-upload-pack foobar
cmp stderr invalidrepoerr.txt
! usundae git-upload-archive
cmp stderr argserr1.txt
! usundae git-upload-archive foobar
cmp stderr invalidrepoerr.txt
! usundae git-receive-pack
cmp stderr argserr1.txt
! usundae git-receive-pack foobar
stdout '.*0000 capabilities.*git.*' # git pack response
stderr '.*something went wrong.*'
! usundae git-lfs-authenticate
cmp stderr argserr2.txt
! usundae git-lfs-authenticate foobar download
cmp stderr invalidrepoerr.txt
! usundae git-lfs-authenticate foobar upload
cmp stderr invalidrepoerr.txt
usundae git-lfs-authenticate repo1 download
stdout '.*header.*Bearer.*href.*expires_in.*expires_at.*'
! usundae git-lfs-authenticate repo1 upload
cmp stderr notauthorizederr.txt
! usundae git-lfs-authenticate repo1p download
cmp stderr notauthorizederr.txt
! usundae git-lfs-authenticate repo1p upload
cmp stderr notauthorizederr.txt
usundae git-lfs-authenticate repo2 download
stdout '.*header.*Bearer.*href.*expires_in.*expires_at.*'
usundae git-lfs-authenticate repo2 upload
stdout '.*header.*Bearer.*href.*expires_in.*expires_at.*'
usundae git-lfs-authenticate repo2p download
stdout '.*header.*Bearer.*href.*expires_in.*expires_at.*'
usundae git-lfs-authenticate repo2p upload
stdout '.*header.*Bearer.*href.*expires_in.*expires_at.*'

# stop the server
[windows] stopserver
[windows] ! stderr .

-- argserr1.txt --
Error: accepts 1 arg(s), received 0
-- argserr2.txt --
Error: accepts 2 arg(s), received 0
-- argserr3.txt --
Error: accepts 2 arg(s), received 1
-- invalidrepoerr.txt --
Error: invalid repo
-- notauthorizederr.txt --
Error: you are not authorized to do this
