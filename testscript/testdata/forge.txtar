# vi: set ft=conf

# Without forges in the config, `forge` is an unknown command.
exec sundae serve &
ensureserverrunning SSH_PORT

! sundae forge ls
stderr 'unknown command "forge"'

stopserver
ensureservernotrunning SSH_PORT

# Declare a forge. Its URL is never contacted by the checks below.
env SUNDAE_FORGES_0_NAME=gh
env SUNDAE_FORGES_0_KIND=github
env SUNDAE_FORGES_0_URL=http://127.0.0.1:1

exec sundae serve &
ensureserverrunning SSH_PORT

# the command is registered
sundae forge --help
stdout 'import'
stdout 'push'
stdout 'sync'

# admins can list forges
sundae forge ls
stdout 'gh'
stdout 'github'
sundae forge ls --json
stdout '"name": "gh"'
stdout '"imported": 0'

# non-admins cannot list, import or sync
sundae user create user1 -k "$USER1_AUTHORIZED_KEY"
! usundae forge ls
stderr 'unauthorized'
! usundae forge repos gh --json
stderr 'unauthorized'
! usundae forge import gh me/repo
stderr 'unauthorized'
! usundae forge import gh --all
stderr 'unauthorized'
! usundae forge sync
stderr 'unauthorized'
! usundae forge sync gh me/repo
stderr 'unauthorized'

# pushing needs write access to the repository
sundae repo create repo1
! usundae forge push repo1
stderr 'unauthorized'
sundae repo collab add repo1 user1
! usundae forge push repo1
stderr 'not linked to a forge'

# anonymous users get nothing either
! ksundae forge ls
stderr 'unauthorized'
! ksundae forge push repo1
stderr 'unauthorized'

# stop the server
[windows] stopserver
[windows] ! stderr .
