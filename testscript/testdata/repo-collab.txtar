# vi: set ft=conf

# start sundae serve
exec sundae serve &
# wait for SSH server to start
ensureserverrunning SSH_PORT

# setup
sundae repo import test https://github.com/charmbracelet/wizard-tutorial.git
sundae user create foo --key "$USER1_AUTHORIZED_KEY"

# list collabs
sundae repo collab list test
! stdout .

# add collab
sundae repo collab add test foo
sundae repo collab list test
stdout 'foo'

# remove collab
sundae repo collab remove test foo
sundae repo collab list test
! stdout .

# create empty repo
sundae repo create empty '-d "empty repo"'

# add collab
sundae repo collab add empty foo
# add collab again
# test upstream Soft Serve issue #464 https://github.com/charmbracelet/soft-serve/issues/464
! sundae repo collab add empty foo
stderr '.*already exists.*'
# a placeholder to reset stderr
sundae help

# a no-access collaborator cannot read a private repo (GHSA-pmgj-8mr6-9rff)
sundae repo create secret -p
! usundae repo description secret
stderr '.*repository not found.*'
sundae repo collab add secret foo no-access
! usundae repo description secret
stderr '.*repository not found.*'
sundae repo collab remove secret foo
sundae repo collab add secret foo read-only
usundae repo description secret

# stop the server
[windows] stopserver
[windows] ! stderr .
