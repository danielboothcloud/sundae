# vi: set ft=conf

# OpenShell sessions are off by default: `session` is an unknown command.
exec soft serve &
ensureserverrunning SSH_PORT

soft repo create repo1

! soft session start repo1
stderr 'unknown command "session"'
! soft session ls
stderr 'unknown command "session"'

stopserver
ensureservernotrunning SSH_PORT

# Enable OpenShell. The gateway is never contacted by the checks below.
env SOFT_SERVE_OPENSHELL_ENABLED=true
env SOFT_SERVE_OPENSHELL_GATEWAY_ADDRESS=http://127.0.0.1:1
env SOFT_SERVE_OPENSHELL_IMAGE=example/sandbox:latest

exec soft serve &
ensureserverrunning SSH_PORT

# the command is registered
soft session --help
stdout 'start'
stdout 'attach'
stdout 'ls'
stdout 'signals'
stdout 'end'

# start and attach need a terminal (ssh -t); start --detach does not
! soft session start repo1
stderr 'requires a terminal \(ssh -t\)'
! soft session attach repo1
stderr 'requires a terminal \(ssh -t\)'
! soft session start repo1 --detach
stderr 'Starting sandbox soft-admin-repo1'

# the failed start is a signal, with its reason; only its owner sees it
soft session signals
stdout 'TIME +STATE +SESSION +MESSAGE'
stdout '✗ failed · start +repo1 / main +could not start the session: '
soft session signals --json --attention
stdout '"type":"lifecycle".*"step":"failed","op":"start"'
soft session signals --repo other
stdout 'No signals yet'
! soft session signals --limit -1
stderr 'must not be negative'

# session names are checked
! soft session end repo1 --name Bad
stderr 'invalid session name'

# with a terminal, `session` bypasses the TUI and reaches the command;
# repository access is checked before the gateway is contacted
! ptysoft session start nope
stderr 'repository not found'
! ptysoft session start repo1
stderr 'Starting sandbox soft-admin-repo1'

# users without read access get the same error as other repo commands
soft user create user1 -k "$USER1_AUTHORIZED_KEY"
soft repo create private1 -p
! usoft session end private1
stderr 'repository not found'
usoft session signals
stdout 'No signals yet'

# anonymous users cannot use sessions
! ksoft session ls
stderr 'unauthorized'
! ksoft session signals
stderr 'unauthorized'
! ksoft session end repo1
stderr 'unauthorized'

# stop the server
[windows] stopserver
[windows] ! stderr .
