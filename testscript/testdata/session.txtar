# vi: set ft=conf

# OpenShell sessions are off by default: `session` is an unknown command.
exec sundae serve &
ensureserverrunning SSH_PORT

sundae repo create repo1

! sundae session start repo1
stderr 'unknown command "session"'
! sundae session ls
stderr 'unknown command "session"'

stopserver
ensureservernotrunning SSH_PORT

# Enable OpenShell. The gateway is never contacted by the checks below.
env SUNDAE_OPENSHELL_ENABLED=true
env SUNDAE_OPENSHELL_GATEWAY_ADDRESS=http://127.0.0.1:1
env SUNDAE_OPENSHELL_IMAGE=example/sandbox:latest

exec sundae serve &
ensureserverrunning SSH_PORT

# the command is registered
sundae session --help
stdout 'start'
stdout 'attach'
stdout 'ls'
stdout 'signals'
stdout 'end'

# start and attach need a terminal (ssh -t); start --detach does not
! sundae session start repo1
stderr 'requires a terminal \(ssh -t\)'
! sundae session attach repo1
stderr 'requires a terminal \(ssh -t\)'
! sundae session start repo1 --detach
stderr 'Starting sandbox sundae-admin-repo1'

# the failed start is a signal, with its reason; only its owner sees it
sundae session signals
stdout 'TIME +STATE +SESSION +MESSAGE'
stdout '✗ failed · start +repo1 / main +could not start the session: '
sundae session signals --json --attention
stdout '"type":"lifecycle".*"step":"failed","op":"start"'
sundae session signals --repo other
stdout 'No signals yet'
! sundae session signals --limit -1
stderr 'must not be negative'

# session names are checked
! sundae session end repo1 --name Bad
stderr 'invalid session name'

# with a terminal, `session` bypasses the TUI and reaches the command;
# repository access is checked before the gateway is contacted
! ptysundae session start nope
stderr 'repository not found'
! ptysundae session start repo1
stderr 'Starting sandbox sundae-admin-repo1'

# users without read access get the same error as other repo commands
sundae user create user1 -k "$USER1_AUTHORIZED_KEY"
sundae repo create private1 -p
! usundae session end private1
stderr 'repository not found'
usundae session signals
stdout 'No signals yet'

# anonymous users cannot use sessions
! ksundae session ls
stderr 'unauthorized'
! ksundae session signals
stderr 'unauthorized'
! ksundae session end repo1
stderr 'unauthorized'

# stop the server
[windows] stopserver
[windows] ! stderr .
