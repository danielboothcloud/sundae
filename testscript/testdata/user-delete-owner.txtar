# vi: set ft=conf

# start sundae serve
exec sundae serve &
# wait for SSH server to start
ensureserverrunning SSH_PORT

sundae user create foo --key "$USER1_AUTHORIZED_KEY"
usundae repo create foo-repo

# a user who owns repositories cannot be removed until they are gone
! sundae user delete foo
stderr '.*still owns repositories.*foo-repo.*'
sundae repo list
stdout 'foo-repo'

sundae repo delete foo-repo
sundae user delete foo
! sundae user info foo
stderr '.*not found.*'
# a placeholder to reset stderr
sundae help

# stop the server
[windows] stopserver
[windows] ! stderr .
