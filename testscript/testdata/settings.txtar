# vi: set ft=conf

# start sundae serve
exec sundae serve &
# wait for SSH server to start
ensureserverrunning SSH_PORT

# check default allow-keyless
sundae settings allow-keyless true
sundae settings allow-keyless
stdout 'true.*'

# change allow-keyless and check
sundae settings allow-keyless false
sundae settings allow-keyless
stdout 'false.*'

# check default anon-access
sundae settings anon-access
stdout 'read-only.*'

# change anon-access to all available options, and check them
sundae settings anon-access no-access
sundae settings anon-access
stdout 'no-access.*'

sundae settings anon-access read-only
sundae settings anon-access
stdout 'read-only.*'

sundae settings anon-access read-write
sundae settings anon-access
stdout 'read-write.*'

sundae settings anon-access admin-access
sundae settings anon-access
stdout 'admin-access.*'

# try to set a bad access
! sundae settings anon-access nope
! stdout .
stderr .

# stop the server
[windows] stopserver

