# vi: set ft=conf

# convert crlf to lf on windows
[windows] dos2unix info.txt

# start sundae serve
exec sundae serve &
# wait for SSH server to start
ensureserverrunning SSH_PORT

# create a repo & user1 with admin
sundae repo create repo1 -p
sundae user create user1 -k "$USER1_AUTHORIZED_KEY"

# setup repo
git clone ssh://localhost:$SSH_PORT/repo1 repo1
mkfile ./repo1/README.md '# Project\nfoo'
git -C repo1 add -A
git -C repo1 commit -m 'first'
git -C repo1 tag v1.0.0
git -C repo1 push origin HEAD
git -C repo1 push origin HEAD --tags

# admin can access it
sundae repo tree repo1
sundae repo blob repo1 README.md
sundae repo description repo1 'desc'
sundae repo project-name repo1 'proj'
sundae repo private repo1
sundae repo info repo1
cmp stdout info.txt

# verify no collab
sundae repo collab list repo1
! stdout .

# regular user can't access it
! usundae repo info repo1
stderr 'repository not found'
! usundae repo tree repo1
stderr 'repository not found'
! usundae repo tag list repo1
stderr 'repository not found'
! usundae repo tag delete repo1 v1.0.0
stderr 'repository not found'
! usundae repo blob repo1 README.md
stderr 'repository not found'
! usundae repo description repo1
stderr 'repository not found'
! usundae repo description repo1 'new desc'
stderr 'repository not found'
! usundae repo project-name repo1
stderr 'repository not found'
! usundae repo private repo1 true
stderr 'repository not found'
! usundae repo private repo1
stderr 'repository not found'
! usundae repo rename repo1 repo11
stderr 'repository not found'
! usundae repo branch default repo1
stderr 'repository not found'
! usundae repo branch default repo1 main
stderr 'repository not found'
! usundae repo delete repo1
stderr 'repository not found'

# add user1 as collab
! sundae repo collab add repo1 user1 foobar
stderr 'invalid access level'
sundae repo collab add repo1 user1 read-write
sundae repo collab list repo1
stdout user1
usundae repo collab list repo1
stdout user1

# verify user1 has access now
usundae repo info repo1
cmp stdout info.txt

# delete
usundae repo delete repo1
usundae repo list
! stdout .

# stop the server
[windows] stopserver
[windows] ! stderr .

-- info.txt --
Project Name: proj
Repository: repo1
Description: desc
VCS: jj
Private: true
Hidden: false
Mirror: false
Owner: admin
Default Bookmark: master
Bookmarks:
  - master
Tags:
  - v1.0.0
