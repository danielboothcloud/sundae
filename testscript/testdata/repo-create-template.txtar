# vi: set ft=conf

# Templates and profiles live in the config file (they have no environment
# form); the SUNDAE_* variables of the test still apply over it.
cp config.yaml $DATA_PATH/config.yaml

# start sundae serve
exec sundae serve &
# wait for SSH server to start
ensureserverrunning SSH_PORT

# the template repository: two commits on main
sundae repo create tpl --vcs git
git clone ssh://localhost:$SSH_PORT/tpl tpl
mkfile ./tpl/README.md '# old'
mkfile ./tpl/old.txt 'only in the first commit'
git -C tpl add -A
git -C tpl commit -m 'first'
git -C tpl push origin HEAD:refs/heads/main
rm ./tpl/old.txt
mkfile ./tpl/README.md '# Template'
mkdir ./tpl/service
mkfile ./tpl/service/main.go 'package main'
git -C tpl add -A
git -C tpl commit -m 'second'
git -C tpl push origin HEAD:refs/heads/main

# create from the template: one commit, the template's tree, by the creator
sundae repo create app --template base
stderr 'Created repository app'
stderr 'Initialised from template base'
stdout 'jj git clone ssh://localhost:'$SSH_PORT'/app.git'
sundae repo tree app
stdout 'README.md'
stdout 'service'
! stdout 'old.txt'
sundae repo blob app README.md
stdout '# Template'
git clone ssh://localhost:$SSH_PORT/app app
git -C app rev-list --count HEAD
stdout '^1$'
git -C app log --format=%an%x20%s
stdout '^admin Initial commit from template base$'

# a subdirectory, as a git repository; the template's profile is stored
sundae repo create svc --template service --vcs git
stderr 'Session profile: claude'
sundae repo tree svc
stdout 'main.go'
! stdout 'README.md'
sundae repo profile svc
stdout '^claude$'

# repo profile: get, set, validate, unset
sundae repo profile app
stdout '^$'
sundae repo profile app shell
sundae repo profile app
stdout '^shell$'
! sundae repo profile app nope
stderr 'unknown profile "nope": use one of claude, shell'
sundae repo profile app --unset
sundae repo profile app
stdout '^$'

# --profile on create
sundae repo create other --profile shell
sundae repo profile other
stdout '^shell$'
! sundae repo create bad --profile nope
stderr 'unknown profile "nope"'
! sundae repo info bad

# unknown templates and missing template repositories
! sundae repo create x --template nope
stderr 'unknown template "nope": use one of base, missing, secret, service'
! sundae repo create x --template missing
stderr 'template "missing": repository "gone": repository not found'
! sundae repo info x

# a user needs read access to the template repository
sundae repo create secret-tpl -p --vcs git
git clone ssh://localhost:$SSH_PORT/secret-tpl secret-tpl
mkfile ./secret-tpl/README.md '# Secret'
git -C secret-tpl add -A
git -C secret-tpl commit -m 'first'
git -C secret-tpl push origin HEAD:refs/heads/main
sundae user create user1 -k "$USER1_AUTHORIZED_KEY"
! usundae repo create mine --template secret
stderr 'template "secret": unauthorized'
! usundae repo info mine
usundae repo create mine --template base
usundae repo blob mine README.md
stdout '# Template'

# collaborators may set a repository's profile; readers may only read it
usundae repo profile app
! usundae repo profile app claude
stderr 'unauthorized'

# --start needs sessions, and creates nothing without them
! sundae repo create started --start
stderr '--start needs agent sessions'
! sundae repo info started

# stop the server
[windows] stopserver
[windows] ! stderr .

-- config.yaml --
sessions:
  profiles:
    claude:
      command: claude
    shell:
      command: zsh -l
projects:
  templates:
    base:
      repo: tpl
      ref: main
      description: The base template
    service:
      repo: tpl
      ref: main
      subdir: service
      profile: claude
    missing:
      repo: gone
    secret:
      repo: secret-tpl
      ref: main
