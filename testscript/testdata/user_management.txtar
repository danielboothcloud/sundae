# vi: set ft=conf

# convert crlf to lf on windows
[windows] dos2unix info.txt admin_key_list1.txt admin_key_list2.txt list1.txt list2.txt foo_info1.txt foo_info2.txt foo_info3.txt foo_info4.txt foo_info5.txt

# start sundae serve
exec sundae serve &
# wait for SSH server to start
ensureserverrunning SSH_PORT

# add key to admin
sundae user add-pubkey admin "$ADMIN2_AUTHORIZED_KEY"
sundae user info admin
sundae info
cmpenv stdout info.txt


# list admin pubkeys
sundae pubkey list
cmpenv stdout admin_key_list1.txt

# remove key
sundae pubkey remove $ADMIN2_AUTHORIZED_KEY
sundae pubkey list
cmpenv stdout admin_key_list2.txt

# add key back key
sundae pubkey add $ADMIN2_AUTHORIZED_KEY
sundae pubkey list
cmpenv stdout admin_key_list1.txt

# list users
sundae user list
cmpenv stdout list1.txt

# create a new user
sundae user create foo --key "$USER1_AUTHORIZED_KEY"
sundae user list
cmpenv stdout list2.txt

# get new user info
sundae user info foo
cmpenv stdout foo_info1.txt

# make user admin
sundae user set-admin foo true
sundae user info foo
cmpenv stdout foo_info2.txt

# remove admin
sundae user set-admin foo false
sundae user info foo
cmpenv stdout foo_info3.txt

# remove key from user
sundae user remove-pubkey foo "$USER1_AUTHORIZED_KEY"
sundae user info foo
cmpenv stdout foo_info4.txt

# rename user
sundae user set-username foo foo2
sundae user info foo2
cmpenv stdout foo_info5.txt

# remove user
sundae user delete foo2
! stdout .
sundae user list
cmpenv stdout list1.txt

# stop the server
[windows] stopserver
[windows] ! stderr .


-- info.txt --
Username: admin
Admin: true
Public keys:
  $ADMIN1_AUTHORIZED_KEY
  $ADMIN2_AUTHORIZED_KEY
-- list1.txt --
admin
-- list2.txt --
admin
foo
-- foo_info1.txt --
Username: foo
Admin: false
Public keys:
  $USER1_AUTHORIZED_KEY
-- foo_info2.txt --
Username: foo
Admin: true
Public keys:
  $USER1_AUTHORIZED_KEY
-- foo_info3.txt --
Username: foo
Admin: false
Public keys:
  $USER1_AUTHORIZED_KEY
-- foo_info4.txt --
Username: foo
Admin: false
Public keys:
-- foo_info5.txt --
Username: foo2
Admin: false
Public keys:
-- admin_key_list1.txt --
$ADMIN1_AUTHORIZED_KEY
$ADMIN2_AUTHORIZED_KEY
-- admin_key_list2.txt --
$ADMIN1_AUTHORIZED_KEY
