# vi: set ft=conf

# start sundae serve
exec sundae serve &
# wait for SSH server to start
ensureserverrunning SSH_PORT

# create user
sundae user create user1 --key "$USER1_AUTHORIZED_KEY"

# generate jwt token
usundae token create 'test1'
stdout 'ss_.*'
stderr 'Access token created'
usundae token create --expires-in 1y 'test2'
stdout 'ss_.*'
stderr 'Access token created'
usundae token create --expires-in 1ns 'test3'
stdout 'ss_.*'
stderr 'Access token created'

# list tokens
usundae token list
cp stdout tokens.txt
grep '1.*test1.*-' tokens.txt
grep '2.*test2.*1 year from now' tokens.txt
grep '3.*est3.*expired' tokens.txt

# delete token
usundae token delete 1
stderr 'Access token deleted'
! usundae token delete 1
stderr 'token not found'

# stop the server
[windows] stopserver
