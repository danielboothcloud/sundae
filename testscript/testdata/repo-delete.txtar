# vi: set ft=conf

# start sundae serve
exec sundae serve &
# wait for SSH server to start
ensureserverrunning SSH_PORT

sundae repo create repo1
sundae repo create repo-to-delete
sundae repo delete repo-to-delete
! sundae repo delete nope
stderr '.*not found.*'

# missing argument should fail
! sundae repo branch delete repo1
stderr 'Error.*accepts 2 arg.*'

sundae repo list
stdout 'repo1'

# stop the server
[windows] stopserver
[windows] ! stderr .
