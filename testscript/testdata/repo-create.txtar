# vi: set ft=conf

# convert crlf to lf on windows
[windows] dos2unix readme.md branch_list.1.txt info.txt

# start sundae serve
exec sundae serve &
# wait for SSH server to start
ensureserverrunning SSH_PORT

# create a repo
sundae repo create repo1 -d 'description' -H -p -n 'repo11'
stderr 'Created repository repo1.*'
stdout ssh://localhost:$SSH_PORT/repo1.git
sundae repo hidden repo1
stdout true
sundae repo private repo1
stdout true
! exists $DATA_PATH/repos/repo1.git/git-daemon-export-ok
sundae repo description repo1
stdout 'description'
readfile $DATA_PATH/repos/repo1.git/description 'description'
sundae repo project-name repo1
stdout 'repo1'

# clone repo
git clone ssh://localhost:$SSH_PORT/repo1 repo1

# create some files, commits, tags...
mkfile ./repo1/README.md '# Project\nfoo'
git -C repo1 add -A
git -C repo1 commit -m 'first'
git -C repo1 tag v0.1.0
git -C repo1 push origin HEAD
git -C repo1 push origin HEAD --tags

# create lfs files, use ssh git-lfs-transfer
git -C repo1 lfs install --local
git -C repo1 lfs track '*.png'
git -C repo1 lfs track '*.mp4'
mkfile ./repo1/foo.png 'foo'
mkfile ./repo1/bar.png 'bar'
git -C repo1 add -A
git -C repo1 commit -m 'lfs'
git -C repo1 push origin HEAD

# info
sundae repo info repo1
cmp stdout info.txt

# list tags
sundae repo tag list repo1
stdout 'v0.1.0'

# delete tag
sundae repo tag delete repo1 v0.1.0
sundae repo tag list repo1
! stdout .

# print tree
sundae repo tree repo1
cp stdout tree.txt
grep '.gitattributes' tree.txt
grep 'README.md' tree.txt
grep 'foo.png' tree.txt
grep 'bar.png' tree.txt

# cat blob
sundae repo blob repo1 README.md
cmp stdout readme.md

# cat blob that doesn't exist
! sundae repo blob repo1 README.txt
! stdout .
stderr '.*revision does not exist.*'

# check main branch
sundae repo branch default repo1
stdout master

# create a new branch
git -C repo1 checkout -b branch1
git -C repo1 push origin branch1
sundae repo branch list repo1
cmp stdout branch_list.1.txt

# change default branch
sundae repo branch default repo1 branch1
sundae repo branch default repo1
stdout branch1

# cannot delete main branch
! sundae repo branch delete repo1 branch1

# delete other branch
sundae repo branch delete repo1 master
sundae repo branch list repo1
stdout branch1

# create a new user
sundae user create bar --key "$USER1_AUTHORIZED_KEY"

# user create a repo
usundae repo create repo2 -d 'description' -H -p -n 'repo2'
stderr 'Created repository repo2.*'
stdout ssh://localhost:$SSH_PORT/repo2.git
usundae repo hidden repo2
stdout true
usundae repo private repo2
stdout true
! exists $DATA_PATH/repos/repo2.git/git-daemon-export-ok
usundae repo description repo2
stdout 'description'
readfile $DATA_PATH/repos/repo2.git/description 'description'
usundae repo project-name repo2
stdout 'repo2'

# user delete a repo
usundae repo delete repo2
! exists $DATA_PATH/repos/repo2.git

# stop the server
[windows] stopserver
[windows] ! stderr .


-- readme.md --
# Project\nfoo
-- branch_list.1.txt --
branch1
master
-- info.txt --
Project Name: repo11
Repository: repo1
Description: description
VCS: jj
Private: true
Hidden: true
Mirror: false
Owner: admin
Default Bookmark: master
Bookmarks:
  - master
Tags:
  - v0.1.0
