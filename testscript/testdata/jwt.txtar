# vi: set ft=conf

# start sundae serve
exec sundae serve &
# wait for SSH server to start
ensureserverrunning SSH_PORT

# create user
sundae user create user1 --key "$USER1_AUTHORIZED_KEY"

# generate jwt token
sundae jwt
stdout '.*\..*\..*'
sundae jwt repo
stdout '.*\..*\..*'
usundae jwt
stdout '.*\..*\..*'
usundae jwt repo
stdout '.*\..*\..*'

# stop the server
[windows] stopserver
[windows] ! stderr .
