# The image the OpenShell sandboxes started by Sundae run
# (config.openshell.image in the Helm chart's values, helm/sundae).
#
# Build it from the repository root. Nothing is copied from the build context.
# See helm/sundae/README.md for the full build and push commands:
#
#   podman build -f deploy/sandbox/Containerfile --platform linux/amd64 \
#     -t <registry>/sundae-sandbox:<tag> deploy/sandbox
#
# What OpenShell 0.1.8 expects of a sandbox image, and what follows from it:
#
# - A standard glibc Linux userland; distroless and scratch images are not
#   supported. The base is Fedora (quay.io/fedora/fedora); OpenShell's own
#   default sandbox image is Ubuntu, and nothing here depends on either.
# - The image's ENTRYPOINT and CMD never run: OpenShell replaces the container
#   command with its own sandbox runtime, which it stages into /.openshell.
#   Nothing here lives under /.openshell or /run, which OpenShell mounts over.
#   There is deliberately no /etc/openshell/policy.yaml: Sundae sends each
#   sandbox it creates its policy (openshell.sandbox_policy: sundae), which
#   takes precedence over one in the image.
# - On Kubernetes the pod runs as the driver's sandbox UID/GID, 10001:10001
#   unless server.sandboxUid/sandboxGid are set in the OpenShell chart. The
#   image's USER is ignored there; Docker and Podman gateways use it. Either
#   way the image declares the same identity with a passwd entry, because ssh
#   and git look the current user up by UID (SANDBOX_UID/SANDBOX_GID below).
# - /sandbox is the workspace and HOME. On Kubernetes it is a volume that
#   OpenShell seeds from this image's /sandbox on first start (fsGroup makes
#   it writable); Sundae clones each repository into /sandbox/<repo>.
# - Sundae runs each session's program (openshell.command, `bash -l` by
#   default, or a profile's command) in the checkout, inside an osewa session
#   (https://github.com/rjyo/osewa), so it keeps running after the SSH client
#   disconnects. OpenShell starts exec'd commands with HOME=/sandbox and a
#   cleared environment: image ENV values other than PATH do not reach them.
#   osewa sessions start with a clean environment too and run the program
#   through `/bin/sh -l`, so login-shell settings go in /etc/profile.d. For a
#   session whose profile has OpenShell providers, Sundae stages the exec
#   environment (the providers' credential placeholders, the proxy's CA
#   variables) in /tmp/sundae/session-env.<pid>, which that shell exports
#   and deletes before starting the program.
# - osewa is installed here as /usr/local/bin/osewa, the release Sundae
#   pins. Sundae uses it when `osewa version` matches its pin; otherwise
#   it uploads the pinned build to /sandbox/.local/lib/sundae. It starts
#   `osewa server` on 127.0.0.1:7322 (loopback only, QUIC and port forwarding
#   off) and keeps osewa's state under /sandbox: ~/.config/osewa (server key,
#   enrolled devices), ~/.local/state/osewa (log, holder sockets) and
#   ~/.config/sundae (the bridge's client identity and session id).
# - Sundae writes the sandbox's short-lived git token to
#   /tmp/sundae/gitconfig (mode 0600) on every session start and attach,
#   and ~/.gitconfig includes that file; the token never lands in /sandbox.
#   The bootstrap uses sh, git, grep, gzip, sha256sum, base64, env and sed,
#   and flock when present; all are in this image.
# - With S3 snapshots on (snapshots.s3), Sundae archives /sandbox with GNU
#   tar and gzip into /tmp/sundae, checks it with md5sum and uploads it
#   with curl to a presigned URL; a restore streams curl | gzip -d | tar -x.
#   All are in this image; the policy Sundae sends allows curl to reach the
#   S3 endpoint.
# - The default filesystem policy grants read-only access to /usr, /bin, /lib
#   and /etc but not /opt, so every tool is installed under /usr; /sandbox and
#   /tmp are writable.

# Pinned by tag and by digest (a multi-arch index: amd64, arm64, ppc64le,
# s390x): Fedora rebuilds this tag with updates. Fedora 45.
ARG BASE_IMAGE=quay.io/fedora/fedora:45@sha256:e15959f36d52307f176f8c068009f6f1451c3b238b37a1f03e56dbfa4526e8b1

# Jujutsu release and the SHA-256 of its static musl tarball per architecture,
# from https://github.com/jj-vcs/jj/releases/tag/v0.47.1. Change all three
# together.
ARG JJ_VERSION=0.47.1
ARG JJ_SHA256_AMD64=d4b657f622ee50929c8916466dfa3d6a6c17a0a32b50e7b2c793707ec9ebcad7
ARG JJ_SHA256_ARM64=0f300e1576de8dabe0a9dedf0b87ae44f8accea5cf54d9a342a51061c1fb1bcd

# osewa release and the SHA-256 of its gzipped static musl build per
# architecture, from SHA256SUMS of
# https://github.com/rjyo/osewa/releases/tag/v0.1.4. Change all three
# together, and with them OsewaVersion and the checksums in
# pkg/openshell/osewa.go and the OSEWA_* arguments of the root Containerfile
# (TestOsewaPinMatchesContainerfiles checks they agree): the osewa protocol is
# a draft and Sundae drives this exact release.
ARG OSEWA_VERSION=0.1.4
ARG OSEWA_SHA256_AMD64=160667bfd60e999b4059b30dfad74fd38c8ab0da413668ec176678a4a0d4bb58
ARG OSEWA_SHA256_ARM64=5a08537f6ebd2b2b6870a54c2c6a78cb26a16d1426e261ab5b8b896d24967325

# The sandbox identity. Match the OpenShell chart's server.sandboxUid and
# server.sandboxGid when you set those; both default to 10001.
ARG SANDBOX_UID=10001
ARG SANDBOX_GID=10001

# --- jj ------------------------------------------------------------------------
# Download and verify the jj binary for the target architecture.
FROM ${BASE_IMAGE} AS jj

ARG TARGETARCH
ARG JJ_VERSION
ARG JJ_SHA256_AMD64
ARG JJ_SHA256_ARM64

RUN dnf -y install --setopt=install_weak_deps=False ca-certificates curl gzip tar \
 && dnf clean all

RUN set -eu; \
    case "${TARGETARCH}" in \
      amd64) triple=x86_64-unknown-linux-musl;  sum="${JJ_SHA256_AMD64}" ;; \
      arm64) triple=aarch64-unknown-linux-musl; sum="${JJ_SHA256_ARM64}" ;; \
      *) echo "unsupported TARGETARCH '${TARGETARCH}' (want amd64 or arm64)" >&2; exit 1 ;; \
    esac; \
    tarball="jj-v${JJ_VERSION}-${triple}.tar.gz"; \
    curl -fsSL --proto '=https' --tlsv1.2 -o "/tmp/${tarball}" \
      "https://github.com/jj-vcs/jj/releases/download/v${JJ_VERSION}/${tarball}"; \
    echo "${sum}  /tmp/${tarball}" | sha256sum -c -; \
    mkdir /tmp/jj; \
    tar -xzf "/tmp/${tarball}" -C /tmp/jj ./jj; \
    install -m 0755 /tmp/jj/jj /out-jj; \
    /out-jj --version

# --- osewa ---------------------------------------------------------------------
# Download and verify the osewa binary for the target architecture. Reuses the
# jj stage, which has curl.
FROM jj AS osewa

ARG TARGETARCH
ARG OSEWA_VERSION
ARG OSEWA_SHA256_AMD64
ARG OSEWA_SHA256_ARM64

RUN set -eu; \
    case "${TARGETARCH}" in \
      amd64) sum="${OSEWA_SHA256_AMD64}" ;; \
      arm64) sum="${OSEWA_SHA256_ARM64}" ;; \
      *) echo "unsupported TARGETARCH '${TARGETARCH}' (want amd64 or arm64)" >&2; exit 1 ;; \
    esac; \
    gz="osewa-linux-${TARGETARCH}.gz"; \
    curl -fsSL --proto '=https' --tlsv1.2 -o "/tmp/${gz}" \
      "https://github.com/rjyo/osewa/releases/download/v${OSEWA_VERSION}/${gz}"; \
    echo "${sum}  /tmp/${gz}" | sha256sum -c -; \
    gzip -dc "/tmp/${gz}" > /out-osewa; \
    chmod 0755 /out-osewa; \
    /out-osewa version

# --- sandbox -------------------------------------------------------------------
FROM ${BASE_IMAGE}

# git-core, bash:  Sundae clones with git (or jj, which runs git) and
#                  runs `bash -l` unless a profile names another program.
#                  git-core is git without the Perl/Tcl extras (send-email,
#                  svn, gitk); install `git` in a derived image for those.
# ca-certificates: TLS for git, jj and curl.
# gzip, tar, util-linux-core (flock), grep, findutils: the bootstrap and S3
#                  snapshot scripts; base64, sha256sum and md5sum come with
#                  the base image's coreutils.
# shadow-utils:    useradd/groupadd below.
# curl, openssh-clients, less, nano, vim-minimal: everyday tools. less is the
#                  pager jj and git use; nano is jj's default editor and the
#                  EDITOR set below; vim-minimal provides vi.
RUN dnf -y install --setopt=install_weak_deps=False \
      bash \
      ca-certificates \
      curl \
      findutils \
      git-core \
      grep \
      gzip \
      less \
      nano \
      openssh-clients \
      shadow-utils \
      tar \
      util-linux-core \
      vim-minimal \
 && dnf clean all

# /usr/bin/jj matches the binary path in the README's example sandbox network
# policy.
COPY --from=jj /out-jj /usr/bin/jj

# The pinned osewa, under /usr (not /opt, which the default sandbox
# filesystem policy does not expose) and on PATH, where Sundae looks for
# it.
COPY --from=osewa /out-osewa /usr/local/bin/osewa

ARG SANDBOX_UID
ARG SANDBOX_GID

# The sandbox identity, named "sandbox" (OpenShell's default session USER),
# with /sandbox as its home. useradd creates /sandbox, owned by that UID/GID,
# and copies the /etc/skel shell start-up files into it.
RUN groupadd --gid "${SANDBOX_GID}" sandbox \
 && useradd --uid "${SANDBOX_UID}" --gid "${SANDBOX_GID}" --home-dir /sandbox \
      --create-home --shell /bin/bash sandbox \
 && chmod 0755 /sandbox

# Read by login shells (`bash -l`, and the `/bin/sh -l` osewa sessions start
# the program with). Only fills in what the caller did not set.
RUN printf '%s\n' \
      '# Sundae sandbox defaults.' \
      ': "${LANG:=C.UTF-8}"; export LANG' \
      ': "${EDITOR:=nano}"; export EDITOR' \
      > /etc/profile.d/sundae-sandbox.sh

WORKDIR /sandbox
USER ${SANDBOX_UID}:${SANDBOX_GID}

# Not run by OpenShell (see above); useful for `podman run -it <image>`.
CMD ["/bin/bash", "-l"]
