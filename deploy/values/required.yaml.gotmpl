{{- /*
  Checks for the values in environment.yaml that have no usable default.

  This file is listed first under every release in helmfile.yaml, including
  the ones that do not use these values, so helmfile stops before it installs
  anything rather than after the gateway is already up. It renders no values.
*/ -}}
{{- $_ := .Values | get "openshell.sandboxImage" "" | required "openshell.sandboxImage is required: it is the image for the sandboxes Sundae starts and has no default. Set it in your values file or with --state-values-set openshell.sandboxImage=<image>" -}}
{{- $_ := .Values | get "sundae.image.repository" "" | required "sundae.image.repository is required: the registry path of your Sundae image, e.g. ghcr.io/<owner>/sundae. Set it in your values file or with --state-values-set sundae.image.repository=<repo>" -}}
{{- $_ := .Values | get "sundae.image.tag" "" | required "sundae.image.tag is required: build and push the image (see deploy/README.md), then set its tag in your values file or with --state-values-set sundae.image.tag=<tag>" -}}
{}
