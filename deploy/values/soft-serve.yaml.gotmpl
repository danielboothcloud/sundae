# Values for the Soft Serve chart (helm/soft-serve), wired to the OpenShell
# release in the same namespace. See values/openshell.yaml.gotmpl for the other
# side of every name and port used here.
{{- $ns := .Release.Namespace }}
{{- $httpURL := printf "http://soft-serve-http.%s.svc.cluster.local:23232" $ns }}
{{- $tlsDir := "/etc/openshell-tls" }}

# values/required.yaml.gotmpl has already checked that the image tag and the
# sandbox image are set.
image:
  repository: {{ .Values.softServe.image.repository | quote }}
  tag: {{ .Values.softServe.image.tag | quote }}

initialAdminKeys:
  {{- .Values | get "softServe.initialAdminKeys" (list) | toYaml | nindent 2 }}

# This Service name and port make up $httpURL above.
service:
  ssh:
    type: {{ .Values | get "softServe.ssh.serviceType" "ClusterIP" | quote }}
    annotations:
      {{- .Values | get "softServe.ssh.serviceAnnotations" (dict) | toYaml | nindent 6 }}
  http:
    type: ClusterIP
    port: 23232

persistence:
  size: {{ .Values | get "softServe.storage.size" "10Gi" | quote }}
  storageClass: {{ .Values | get "softServe.storage.storageClass" "" | quote }}

openshell:
  clientTLS:
    secretName: openshell-client-tls
    mountPath: {{ $tlsDir | quote }}

config:
  ssh:
    public_url: {{ .Values | get "softServe.ssh.publicURL" "ssh://localhost:23231" | quote }}
  http:
    # HTTP is only exposed inside the cluster in this deployment.
    public_url: {{ $httpURL | quote }}
  openshell:
    enabled: true
    # The OpenShell gateway Service, by the DNS name its certificate carries.
    gateway_address: {{ printf "https://openshell.%s.svc.cluster.local:8080" $ns | quote }}
    # The default sandbox image.
    image: {{ .Values.openshell.sandboxImage | quote }}
    # The mounted client TLS secret.
    tls_ca: {{ printf "%s/ca.crt" $tlsDir | quote }}
    tls_cert: {{ printf "%s/tls.crt" $tlsDir | quote }}
    tls_key: {{ printf "%s/tls.key" $tlsDir | quote }}
    # Where sandboxes clone from and push to: Soft Serve's in-cluster HTTP
    # Service. The sandbox network policy must allow this host and port.
    clone_url: {{ $httpURL | quote }}
