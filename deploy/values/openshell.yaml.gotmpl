# Values for the OpenShell chart (oci://ghcr.io/nvidia/openshell/helm-chart).
#
# Everything here is already the chart's default in 0.1.8. It is spelled out
# because values/sundae.yaml.gotmpl depends on it: the gateway Service is
# "openshell" on port 8080, it serves TLS and requires a client certificate,
# and the client certificate is in the Secret "openshell-client-tls".

# Service name = chart fullname = release name ("openshell").
nameOverride: openshell

service:
  # The gateway's gRPC port.
  port: 8080

server:
  disableTls: false
  tls:
    enableMtls: true
    # Created by the chart's certgen hook Job with the keys ca.crt, tls.crt and
    # tls.key. Sundae mounts it.
    clientTlsSecretName: openshell-client-tls

# The hook Job that creates the TLS Secrets. Its server certificate covers
# openshell.<namespace>.svc.cluster.local for whatever namespace this is.
pkiInitJob:
  enabled: true

# Leave the chart's Agent Sandbox preflight on: it stops the install early when
# the cluster does not serve the Sandbox API.
agentSandbox:
  preflight:
    enabled: true
